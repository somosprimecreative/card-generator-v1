# Crie esta variável no painel da Vercel para habilitar a geração de roteiros com Claude.
# Em projetos Vercel com OIDC habilitado, este valor pode não ser necessário em produção.
AI_GATEWAY_API_KEY=

# Reutilize exatamente o mesmo projeto Supabase do Órbita. Nunca crie um
# projeto/tabelas paralelos para o Pixel. Os valores devem ficar apenas no
# ambiente local ou na Vercel, nunca neste arquivo.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
